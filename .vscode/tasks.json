{
    "version": "2.0.0",
    "tasks": [
      {
        "type": "shell",
        "label": "Сборка",
        "command": "npm",
        "args": ["run", "build", "--prefix", "./react"],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [],
        "detail": "Сборка проекта"
      },

  
      {
        "type": "shell",
        "label": "Установить зависимости",
        "command": "npm",
        "args": ["install"],
        "problemMatcher": [],
        "detail": "Установка зависимостей",
        "options": {
            "cwd": "./react"
        }
      },
      {
        "type": "shell",
        "label": "Тесты Python",
        "command": "${command:python.interpreterPath}",
        "args": ["-m", "pytest", "tests"],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "problemMatcher": ["$python"],
        "detail": "Запуск тестов Python-приложения"
      }
    ]
  }
